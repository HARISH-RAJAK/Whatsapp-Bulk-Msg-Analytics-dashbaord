# ==============================================================================
# ClickNCult Backend Environment Configuration (Template)
# ==============================================================================

# Application Environment (production / development / staging)
APP_ENV=production
APP_DEBUG=false

# Backend Public Host Base URL
APP_URL=https://api.yourdomain.com

# Frontend Application URL (used for CORS and redirect policies)
FRONTEND_URL=https://app.yourdomain.com

# MySQL Database Configuration (PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clickncult_analytics
DB_USERNAME=clickncult_db_user
DB_PASSWORD=your_strong_database_password

# MSG91 WhatsApp Webhook Security
MSG91_WEBHOOK_SECRET=your_configured_webhook_secret_key
MSG91_REQUIRE_AUTH=true

